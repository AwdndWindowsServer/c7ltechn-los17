diff --git a/include/linux/wakelock.h b/include/linux/wakelock.h
new file mode 100644
index 000000000..93efb682e
--- /dev/null
+++ b/include/linux/wakelock.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * wakelock.h — C7ROM port shim
+ *
+ * Linux 4.9 已经删掉了 Android wakelock（改成语义等价的 wakeup_source）。
+ * 三星 3.18 驱动（NFC / 指纹 / eSE / mux_sel …）大量使用旧 API，
+ * 这里用 wakeup_source 做一层薄封装，行为对齐：
+ *   wake_lock_init  -> wakeup_source_init
+ *   wake_lock       -> __pm_stay_awake
+ *   wake_unlock     -> __pm_relax
+ *   wake_lock_timeout -> __pm_wakeup_event
+ */
+#ifndef _LINUX_WAKELOCK_H
+#define _LINUX_WAKELOCK_H
+
+#include <linux/device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/jiffies.h>
+
+#define WAKE_LOCK_SUSPEND	0
+#define WAKE_LOCK_IDLE		1
+
+struct wake_lock {
+	struct wakeup_source ws;
+};
+
+static inline void wake_lock_init(struct wake_lock *lock, int type, const char *name)
+{
+	wakeup_source_init(&lock->ws, name);
+}
+
+static inline void wake_lock_destroy(struct wake_lock *lock)
+{
+	wakeup_source_destroy(&lock->ws);
+}
+
+static inline void wake_lock(struct wake_lock *lock)
+{
+	__pm_stay_awake(&lock->ws);
+}
+
+static inline void wake_unlock(struct wake_lock *lock)
+{
+	__pm_relax(&lock->ws);
+}
+
+static inline void wake_lock_timeout(struct wake_lock *lock, long timeout)
+{
+	__pm_wakeup_event(&lock->ws, jiffies_to_msecs(timeout));
+}
+
+static inline int wake_lock_active(struct wake_lock *lock)
+{
+	return lock->ws.active;
+}
+
+#endif /* _LINUX_WAKELOCK_H */
