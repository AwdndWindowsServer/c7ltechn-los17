diff --git a/drivers/hwmon/sec_thermistor.c b/drivers/hwmon/sec_thermistor.c
new file mode 100644
index 000000000..d58ed8c97
--- /dev/null
+++ b/drivers/hwmon/sec_thermistor.c
@@ -0,0 +1,441 @@
